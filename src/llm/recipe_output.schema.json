{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecipeOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain_of_thought",
    "title",
    "servings",
    "ingredients",
    "time_minutes",
    "difficulty",
    "steps"
  ],
  "properties": {
    "chain_of_thought": {
      "type": "string",
      "minLength": 1,
      "description": "Step-by-step reasoning used internally before the final recipe.",
      "x-ui-hidden": true
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Short and descriptive name of the recipe.",
      "title": "Receta",
      "x-ui-widget": "title"
    },
    "servings": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of servings.",
      "title": "Raciones"
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "description": "Ingredients list.",
      "title": "Ingredientes",
      "x-ui-list-style": "bullet",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "time_minutes": {
      "type": "integer",
      "minimum": 1,
      "description": "Estimated cooking time in minutes.",
      "title": "Tiempo aproximado (minutos)"
    },
    "difficulty": {
      "type": "string",
      "description": "Recipe difficulty.",
      "title": "Dificultad",
      "enum": [
        "Easy",
        "Medium",
        "Hard"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Cooking steps.",
      "title": "Pasos",
      "x-ui-list-style": "numbered",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
